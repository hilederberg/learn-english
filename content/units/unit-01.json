 "grammar": [
  {
   "id": "g01-tobe",
   "titleHe": "to be: am / is / are",
   "ruleHe": "באנגלית חייב להיות פועל במשפט. בעברית אומרים 'אני סטודנטית', באנגלית אומרים I am a student. I am, you are, he/she/it is, we/you/they are.",
   "examples": [
    {
     "en": "I am a student.",
     "he": "אני סטודנטית."
    },
    {
     "en": "She is from Italy.",
     "he": "היא מאיטליה."
    },
    {
     "en": "We are friends.",
     "he": "אנחנו חברות."
    }
   ],
   "drills": [
    {
     "type": "build",
     "he": "אני מישראל",
     "answer": "I am from Israel"
    },
    {
     "type": "build",
     "he": "היא סטודנטית",
     "answer": "She is a student"
    },
    {
     "type": "build",
     "he": "אנחנו חברות",
     "answer": "We are friends"
    },
    {
     "type": "fill",
     "he": "הם מספרד",
     "text": "They ___ from Spain.",
     "answer": "are"
    }
   ]
  },
  {
   "id": "g01-aan",
   "titleHe": "a / an",
   "ruleHe": "לפני שם עצם יחיד אומרים a או an. a לפני צליל עיצור (a student), an לפני צליל תנועה (an apple, an engineer). חשוב הצליל ולא האות: an hour (ה שותקת).",
   "examples": [
    {
     "en": "I am a student.",
     "he": "אני סטודנטית."
    },
    {
     "en": "She is an engineer.",
     "he": "היא מהנדסת."
    },
    {
     "en": "I need an umbrella.",
     "he": "אני צריכה מטריה."
    }
   ],
   "drills": [
    {
     "type": "fill",
